# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (or legacy "anon") key. Safe for the browser: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public URL of this app, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix, never sent to the browser). Enables the
# AI Test Generator; the app runs without it. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# NEVER add the service-role / secret key here. The web app does not use it.
# It belongs only to the test worker (Phase 2), on its own host.
