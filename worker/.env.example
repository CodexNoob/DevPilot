# Copy to worker/.env. The worker is the ONLY component that holds the secret key.
# Never put SUPABASE_SECRET_KEY in the web app's .env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional tuning
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=1
WORKER_STEP_TIMEOUT_MS=15000
WORKER_TEST_TIMEOUT_MS=120000
WORKER_STALE_RUN_MINUTES=60
